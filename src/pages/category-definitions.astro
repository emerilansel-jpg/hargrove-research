---
import BaseLayout from '../layouts/BaseLayout.astro';

const formats = [
  { name: 'Market Report', desc: 'Comprehensive analysis of a market or sector' },
  { name: 'Category Benchmark', desc: 'Comparative evaluation of providers against fixed criteria' },
  { name: 'Comparative Analysis', desc: 'Side-by-side comparison of solutions or approaches' },
  { name: 'Research Primer', desc: 'Introductory overview of an emerging category' },
  { name: 'Category Definition', desc: 'Defining a new or evolving market category' },
];
---

<BaseLayout title="Category Definitions" description="Category Definitions — Hargrove Research Group. Our research taxonomy defines the categories and output formats used across our publications.">

  <section class="page-hero">
    <div class="container">
      <span class="kicker reveal">Research Taxonomy</span>
      <h1 class="page-hero__title reveal" data-delay="1">
        Category <em>definitions</em>
      </h1>
      <p class="page-hero__sub reveal" data-delay="2">
        Our research taxonomy defines the categories and output formats used across
        our publications.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__header reveal">
        <div>
          <span class="section__label">Output Formats</span>
          <h2 class="text-balance">How we classify research</h2>
        </div>
      </div>

      <div class="format-grid">
        {formats.map((f, i) => (
          <div class="format-card reveal" data-delay={String((i % 3) + 1)}>
            <span class="format-card__num mono">{String(i + 1).padStart(2, '0')}</span>
            <h3>{f.name}</h3>
            <p>{f.desc}</p>
          </div>
        ))}
      </div>

      <div class="page-cta reveal" data-delay="1">
        <div>
          <h2>See them in action</h2>
          <p>Browse our published research to see each output format applied in practice.</p>
        </div>
        <a href="/insights" class="btn btn-outline">View Insights</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .page-hero {
    padding: 9rem 0 4rem;
    background: linear-gradient(180deg, var(--paper-warm) 0%, var(--paper) 100%);
    border-bottom: 1px solid var(--border-hairline);
  }
  .page-hero__title {
    font-size: clamp(2.5rem, 5.5vw, 4rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--ink-900);
    margin: 1rem 0 1.5rem;
    line-height: 1.05;
  }
  .page-hero__title em {
    font-style: italic;
    font-weight: 400;
    color: var(--copper-500);
  }
  .page-hero__sub {
    font-size: 1.125rem;
    color: var(--text-700);
    line-height: 1.7;
    max-width: 640px;
  }

  .format-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }
  .format-card {
    background: #fff;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius);
    padding: 2rem;
    transition: transform 320ms var(--ease-out), box-shadow 320ms var(--ease-out), border-color 320ms var(--ease-out);
  }
  .format-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--copper-400);
  }
  .format-card__num {
    font-size: 0.75rem;
    color: var(--copper-500);
    font-weight: 600;
    letter-spacing: 0.16em;
    display: block;
    margin-bottom: 1rem;
  }
  .format-card h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--ink-900);
    margin-bottom: 0.625rem;
    letter-spacing: -0.015em;
  }
  .format-card p {
    color: var(--text-500);
    font-size: 0.9375rem;
    line-height: 1.65;
    margin: 0;
  }

  .page-cta {
    padding: 2.5rem;
    background: var(--ink-950);
    color: #fff;
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .page-cta h2 {
    color: #fff;
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  .page-cta p {
    color: rgba(199, 208, 232, 0.7);
    margin: 0;
    font-size: 0.9375rem;
  }

  @media (max-width: 768px) {
    .page-hero { padding: 7rem 0 3rem; }
    .page-cta { flex-direction: column; align-items: flex-start; }
  }
</style>
