---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Editorial Policy" description="Editorial Policy — Hargrove Research Group maintains strict editorial independence. Our editorial policies ensure that research output is never influenced by commercial relationships, sponsorships, or external pressure.">

  <section class="page-hero">
    <div class="container">
      <span class="kicker reveal">Editorial Standards</span>
      <h1 class="page-hero__title reveal" data-delay="1">
        Editorial <em>independence</em>
      </h1>
      <p class="page-hero__sub reveal" data-delay="2">
        Hargrove Research Group maintains strict editorial independence. Our editorial policies
        ensure that research output is never influenced by commercial relationships,
        sponsorships, or external pressure.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:880px;">
      <div class="article-body">
        <div class="principles-list reveal">
          <span class="section__label">Core Principles</span>
          <ul class="principle-items">
            <li>
              <span class="principle-items__icon" aria-hidden="true">✓</span>
              <span>Research criteria are fixed before evaluation begins</span>
            </li>
            <li>
              <span class="principle-items__icon" aria-hidden="true">✓</span>
              <span>No pay-to-rank or sponsored placement</span>
            </li>
            <li>
              <span class="principle-items__icon" aria-hidden="true">✓</span>
              <span>All commercial relationships are disclosed</span>
            </li>
            <li>
              <span class="principle-items__icon" aria-hidden="true">✓</span>
              <span>Corrections are welcomed and published transparently</span>
            </li>
          </ul>
        </div>
      </div>

      <div class="page-cta reveal" data-delay="1">
        <div>
          <h2>See how we apply it</h2>
          <p>Read our full methodology — criteria, evidence classes, and limitations.</p>
        </div>
        <a href="/methodology" class="btn btn-outline">View Methodology</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .page-hero {
    padding: 9rem 0 4rem;
    background: linear-gradient(180deg, var(--paper-warm) 0%, var(--paper) 100%);
    border-bottom: 1px solid var(--border-hairline);
  }
  .page-hero__title {
    font-size: clamp(2.5rem, 5.5vw, 4rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--ink-900);
    margin: 1rem 0 1.5rem;
    line-height: 1.05;
  }
  .page-hero__title em {
    font-style: italic;
    font-weight: 400;
    color: var(--copper-500);
  }
  .page-hero__sub {
    font-size: 1.125rem;
    color: var(--text-700);
    line-height: 1.7;
    max-width: 640px;
  }

  .principles-list {
    background: #fff;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-lg);
    padding: 3rem;
  }
  .principle-items {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .principle-items li {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    font-size: 1.0625rem;
    color: var(--text-700);
    line-height: 1.6;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-hairline);
  }
  .principle-items li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .principle-items__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px; height: 24px;
    border-radius: 50%;
    background: var(--copper-100);
    color: var(--copper-500);
    font-size: 0.75rem;
    font-weight: 700;
    margin-top: 2px;
  }

  .page-cta {
    margin-top: 3rem;
    padding: 2.5rem;
    background: var(--ink-950);
    color: #fff;
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .page-cta h2 {
    color: #fff;
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  .page-cta p {
    color: rgba(199, 208, 232, 0.7);
    margin: 0;
    font-size: 0.9375rem;
  }

  @media (max-width: 768px) {
    .page-hero { padding: 7rem 0 3rem; }
    .principles-list { padding: 2rem; }
    .page-cta { flex-direction: column; align-items: flex-start; }
  }
</style>
