---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Page Not Found" description="The page you're looking for doesn't exist.">

  <section class="page-hero">
    <div class="container">
      <span class="kicker reveal">Error 404</span>
      <h1 class="page-hero__title reveal" data-delay="1">
        Page <em>not found.</em>
      </h1>
      <p class="page-hero__sub reveal" data-delay="2">
        The page you're looking for doesn't exist. It may have been moved, renamed,
        or the link may be broken.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:880px;">
      <div class="error-actions reveal">
        <div class="error-actions__card">
          <span class="error-actions__icon" aria-hidden="true">⌖</span>
          <h3>Search our research</h3>
          <p>Browse all published reports, benchmarks, and analysis from our insights archive.</p>
          <a href="/insights" class="btn btn-outline">View Insights</a>
        </div>
        <div class="error-actions__card">
          <span class="error-actions__icon" aria-hidden="true">⌂</span>
          <h3>Return home</h3>
          <p>Head back to the homepage for an overview of our research and methodology.</p>
          <a href="/" class="btn">Return Home</a>
        </div>
      </div>

      <div class="error-help reveal" data-delay="2">
        <p>Think this is a mistake? <a href="mailto:corrections@hargroveresearch.com" class="link-arrow">Let us know</a></p>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .page-hero {
    padding: 9rem 0 4rem;
    background: linear-gradient(180deg, var(--paper-warm) 0%, var(--paper) 100%);
    border-bottom: 1px solid var(--border-hairline);
  }
  .page-hero__title {
    font-size: clamp(2.5rem, 5.5vw, 4rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--ink-900);
    margin: 1rem 0 1.5rem;
    line-height: 1.05;
  }
  .page-hero__title em {
    font-style: italic;
    font-weight: 400;
    color: var(--copper-500);
  }
  .page-hero__sub {
    font-size: 1.125rem;
    color: var(--text-700);
    line-height: 1.7;
    max-width: 640px;
  }

  .error-actions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .error-actions__card {
    background: #fff;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius);
    padding: 2.5rem;
    text-align: center;
    transition: transform 320ms var(--ease-out), box-shadow 320ms var(--ease-out), border-color 320ms var(--ease-out);
  }
  .error-actions__card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--copper-400);
  }
  .error-actions__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px; height: 56px;
    border-radius: 50%;
    background: var(--copper-100);
    color: var(--copper-500);
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .error-actions__card h3 {
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--ink-900);
    margin-bottom: 0.75rem;
  }
  .error-actions__card p {
    color: var(--text-500);
    font-size: 0.9375rem;
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  .error-help {
    margin-top: 3rem;
    text-align: center;
    padding: 2rem;
    background: var(--paper-warm);
    border-radius: var(--radius);
    border: 1px solid var(--border-soft);
  }
  .error-help p {
    margin: 0;
    color: var(--text-500);
    font-size: 0.9375rem;
  }

  @media (max-width: 768px) {
    .page-hero { padding: 7rem 0 3rem; }
  }
</style>
