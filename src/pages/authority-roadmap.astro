---
import BaseLayout from '../layouts/BaseLayout.astro';

const milestones = [
  { label: 'Published methodology', done: true },
  { label: 'Named reviewers', done: true },
  { label: 'Open correction pathway', done: true },
  { label: 'Evidence classification system', done: true },
  { label: 'Limitations documentation', done: true },
];
---

<BaseLayout title="Authority Roadmap" description="Authority Roadmap — Hargrove Research Group. Our roadmap for building and maintaining research authority and trust signals.">

  <section class="page-hero">
    <div class="container">
      <span class="kicker reveal">Trust Signals</span>
      <h1 class="page-hero__title reveal" data-delay="1">
        Authority <em>roadmap</em>
      </h1>
      <p class="page-hero__sub reveal" data-delay="2">
        Our roadmap for building and maintaining research authority and trust signals.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:880px;">
      <div class="section__header reveal">
        <div>
          <span class="section__label">Current Milestones</span>
          <h2 class="text-balance">What we have shipped</h2>
        </div>
      </div>

      <div class="roadmap-list reveal" data-delay="1">
        {milestones.map((m, i) => (
          <div class="roadmap-item">
            <span class="roadmap-item__check" aria-hidden="true">✓</span>
            <span class="roadmap-item__label">{m.label}</span>
            <span class="roadmap-item__status mono">Complete</span>
          </div>
        ))}
      </div>

      <div class="page-cta reveal" data-delay="2">
        <div>
          <h2>Explore our standards</h2>
          <p>Read the methodology, editorial policy, and evidence classification behind these milestones.</p>
        </div>
        <a href="/methodology" class="btn btn-outline">View Methodology</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .page-hero {
    padding: 9rem 0 4rem;
    background: linear-gradient(180deg, var(--paper-warm) 0%, var(--paper) 100%);
    border-bottom: 1px solid var(--border-hairline);
  }
  .page-hero__title {
    font-size: clamp(2.5rem, 5.5vw, 4rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--ink-900);
    margin: 1rem 0 1.5rem;
    line-height: 1.05;
  }
  .page-hero__title em {
    font-style: italic;
    font-weight: 400;
    color: var(--copper-500);
  }
  .page-hero__sub {
    font-size: 1.125rem;
    color: var(--text-700);
    line-height: 1.7;
    max-width: 640px;
  }

  .roadmap-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 2rem;
  }
  .roadmap-item {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.5rem 2rem;
    background: #fff;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius);
    transition: transform 320ms var(--ease-out), box-shadow 320ms var(--ease-out), border-color 320ms var(--ease-out);
  }
  .roadmap-item:hover {
    transform: translateX(4px);
    box-shadow: var(--shadow-sm);
    border-color: var(--copper-400);
  }
  .roadmap-item__check {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px; height: 32px;
    border-radius: 50%;
    background: var(--signal-500);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 700;
  }
  .roadmap-item__label {
    flex: 1;
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--ink-900);
  }
  .roadmap-item__status {
    font-size: 0.6875rem;
    color: var(--signal-500);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 600;
    padding: 4px 10px;
    background: rgba(79, 199, 159, 0.1);
    border-radius: 4px;
  }

  .page-cta {
    margin-top: 3rem;
    padding: 2.5rem;
    background: var(--ink-950);
    color: #fff;
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .page-cta h2 {
    color: #fff;
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  .page-cta p {
    color: rgba(199, 208, 232, 0.7);
    margin: 0;
    font-size: 0.9375rem;
  }

  @media (max-width: 768px) {
    .page-hero { padding: 7rem 0 3rem; }
    .roadmap-item { flex-wrap: wrap; }
    .page-cta { flex-direction: column; align-items: flex-start; }
  }
</style>
