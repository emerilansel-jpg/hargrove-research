---
// Hargrove Research Group — Financial Research Publisher
// Hero section + KPI strip + research reports + methodology + newsletter + footer

import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('research'))
  .filter(p => p.data.status === 'Live')
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 6);

const kpis = [
  { value: '94.2%', label: 'GPT-5 Accuracy', sub: 'Independently audited across 11,400 enterprise prompts' },
  { value: '3.7×', label: 'RAG Efficiency', sub: 'Mean throughput uplift in F500 deployment sample' },
  { value: '67%', label: 'F500 Adoption', sub: 'Companies deploying verified AI workflows in production' },
  { value: '$4.2B', label: 'Capital Tracked', sub: 'AUM informed by Hargrove verification frameworks' },
];

const methodology = [
  { step: '01', title: 'Define', desc: 'Fixed criteria published before any vendor is named.' },
  { step: '02', title: 'Collect', desc: 'Primary data, interviews, filings — on the record.' },
  { step: '03', title: 'Review', desc: 'Named reviewers evaluate methodology and evidence.' },
  { step: '04', title: 'Publish', desc: 'Methodology, limitations, conflicts — all public.' },
];

const pressLogos = [
  { name: 'Financial Times', file: 'financial-times.svg' },
  { name: 'Bloomberg', file: 'bloomberg.svg' },
  { name: 'Wall Street Journal', file: 'wsj.svg' },
  { name: 'Reuters', file: 'reuters.svg' },
  { name: 'The Economist', file: 'economist.svg' },
  { name: 'TechCrunch', file: 'techcrunch.svg' },
];
---

<BaseLayout title="Home" description="Independent benchmarks, deployment analysis, and governance research for enterprise AI — from model evaluation to production readiness.">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Instrument+Serif&family=Inter:wght@300;400;500;600;700&display=swap');

    :root {
      --navy: #0A1128;
      --navy-light: #111D3A;
      --navy-mid: #162042;
      --copper: #C97B2D;
      --copper-light: #E0A55B;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    .hero {
      position: relative;
      min-height: 92vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #0A1128 0%, #111D3A 50%, #0A1128 100%);
      overflow: hidden;
      isolation: isolate;
    }

    .hero::before {
      content: '';
      position: absolute;
      top: -50%; left: -50%;
      width: 200%; height: 200%;
      background:
        radial-gradient(circle at 20% 80%, rgba(201,123,45,0.12) 0%, transparent 50%),
        radial-gradient(circle at 80% 20%, rgba(109,93,246,0.10) 0%, transparent 50%);
      animation: gradientShift 20s ease-in-out infinite;
      z-index: 0;
    }

    @keyframes gradientShift {
      0%,100% { transform: translate(0,0) rotate(0deg); }
      33% { transform: translate(30px,-30px) rotate(3deg); }
      66% { transform: translate(-20px,20px) rotate(-3deg); }
    }

    .hero-inner { position: relative; z-index: 2; max-width: 800px; text-align: center; padding: 2rem; }

    .hero-kicker {
      display: inline-flex; align-items: center; gap: 8px;
      font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase;
      color: var(--copper-light); padding: 8px 16px;
      border: 1px solid rgba(201,123,45,0.3); border-radius: 999px;
      background: rgba(201,123,45,0.06); backdrop-filter: blur(8px);
      margin-bottom: 2rem;
    }

    .hero-kicker .dot {
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--copper); animation: pulse 2s ease-in-out infinite;
    }

    @keyframes pulse { 0%,100% { opacity:1; } 50% { opacity:0.4; } }

    .hero-title {
      font-family: 'Instrument Serif', serif;
      font-size: clamp(2.5rem, 6vw, 4.5rem);
      color: #fff; line-height: 1.05; margin-bottom: 1.5rem;
      letter-spacing: -0.03em;
    }

    .hero-title em {
      font-style: italic; font-weight: 400;
      background: linear-gradient(135deg, var(--copper), var(--copper-light));
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero-sub {
      font-size: 1.125rem; color: rgba(199,208,232,0.7);
      line-height: 1.7; max-width: 600px; margin: 0 auto 2rem;
    }

    .hero-ctas { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

    .btn {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 14px 28px; border-radius: 8px; font-weight: 600;
      font-size: 0.9375rem; text-decoration: none; transition: all 0.3s ease;
      border: none; cursor: pointer;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--copper), #A8641F);
      color: #fff;
      box-shadow: 0 4px 12px rgba(201,123,45,0.3);
    }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(201,123,45,0.4); }

    .btn-outline {
      background: transparent; color: #fff;
      border: 1px solid rgba(255,255,255,0.3);
    }
    .btn-outline:hover { background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.5); }

    /* KPI Strip */
    .kpi-strip {
      display: grid; grid-template-columns: repeat(4, 1fr);
      gap: 1px; background: rgba(199,208,232,0.1);
      border: 1px solid rgba(199,208,232,0.1);
      border-radius: 16px; overflow: hidden;
      max-width: 900px; margin: 3rem auto 0;
    }

    .kpi-item {
      padding: 1.5rem; text-align: center;
      background: rgba(16,27,60,0.8); backdrop-filter: blur(12px);
      transition: background 0.3s ease;
    }
    .kpi-item:hover { background: rgba(16,27,60,1); }

    .kpi-value {
      font-family: 'Instrument Serif', serif;
      font-size: 2rem; font-weight: 600; color: var(--copper);
      line-height: 1; margin-bottom: 0.5rem;
    }

    .kpi-label {
      font-size: 0.6875rem; text-transform: uppercase;
      letter-spacing: 0.12em; color: rgba(199,208,232,0.6);
      margin-bottom: 0.25rem;
    }

    .kpi-sub {
      font-size: 0.75rem; color: rgba(199,208,232,0.4); line-height: 1.4;
    }

    /* Sections */
    .section { padding: 6rem 0; }
    .section-dark { background: var(--navy); color: #fff; }
    .section-light { background: #FAF9F6; }
    .container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }

    .section-label {
      font-size: 0.6875rem; text-transform: uppercase;
      letter-spacing: 0.18em; color: var(--copper);
      display: flex; align-items: center; gap: 10px;
      margin-bottom: 1rem;
    }
    .section-label::before { content: ''; width: 24px; height: 1px; background: currentColor; }

    .section-title {
      font-family: 'Instrument Serif', serif;
      font-size: clamp(1.875rem, 4vw, 3rem);
      color: inherit; margin-bottom: 3rem; letter-spacing: -0.02em;
    }

    /* Press Strip */
    .press-strip {
      padding: 2.5rem 0;
      background: var(--paper-warm, #F4F1EA);
      border-bottom: 1px solid rgba(15,23,42,0.08);
      text-align: center;
    }
    .press-label {
      font-size: 0.6875rem; text-transform: uppercase;
      letter-spacing: 0.18em; color: #94A3B8; margin-bottom: 1.5rem;
    }
    .press-logos {
      display: flex; justify-content: center; align-items: center;
      gap: 3rem; flex-wrap: wrap;
    }
    .press-logo-link {
      display: flex; align-items: center; justify-content: center;
      min-height: 44px; text-decoration: none;
    }
    .press-logo-img {
      height: 32px; width: auto; opacity: 0.5;
      filter: grayscale(100%);
      transition: opacity 0.3s ease, filter 0.3s ease;
    }
    .press-logo-link:hover .press-logo-img { opacity: 0.85; filter: grayscale(0%); }

    /* Reports Grid */
    .reports-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 1.5rem;
    }

    .report-card {
      background: rgba(17,29,58,0.6);
      border: 1px solid rgba(199,208,232,0.1);
      border-radius: 12px; overflow: hidden;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      text-decoration: none; color: inherit;
    }
    .report-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 40px rgba(0,0,0,0.3);
    }

    .report-img {
      width: 100%; height: 200px; object-fit: cover; opacity: 0.85;
      transition: opacity 0.3s ease;
    }
    .report-card:hover .report-img { opacity: 1; }

    .report-body { padding: 1.5rem; }
    .report-tag {
      display: inline-block; font-size: 0.625rem; text-transform: uppercase;
      letter-spacing: 0.12em; padding: 4px 10px; border-radius: 4px;
      background: rgba(201,123,45,0.15); color: var(--copper-light);
      margin-bottom: 0.75rem;
    }
    .report-title {
      font-family: 'Instrument Serif', serif;
      font-size: 1.25rem; color: #fff; margin-bottom: 0.75rem;
      line-height: 1.3;
    }
    .report-desc {
      font-size: 0.875rem; color: rgba(199,208,232,0.6);
      line-height: 1.6; margin-bottom: 1rem;
    }
    .report-meta {
      font-size: 0.75rem; color: rgba(199,208,232,0.4);
      display: flex; justify-content: space-between;
    }

    /* Methodology */
    .method-grid {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem;
    }

    .method-step {
      text-align: center; padding: 2rem 1rem;
      border: 1px solid rgba(199,208,232,0.1);
      border-radius: 12px; transition: transform 0.3s ease;
    }
    .method-step:hover { transform: translateY(-4px); }

    .method-num {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.75rem; color: var(--copper); letter-spacing: 0.16em;
      margin-bottom: 0.5rem;
    }
    .method-step h3 {
      font-family: 'Instrument Serif', serif;
      font-size: 1.25rem; color: #fff; margin-bottom: 0.5rem;
    }
    .method-step p {
      font-size: 0.875rem; color: rgba(199,208,232,0.6); line-height: 1.6;
    }

    /* Newsletter */
    .newsletter {
      display: grid; grid-template-columns: 1.1fr 1fr;
      gap: 3rem; align-items: center;
    }
    .newsletter h2 {
      font-family: 'Instrument Serif', serif;
      font-size: clamp(1.75rem, 3vw, 2.5rem); color: #fff;
      margin-bottom: 1rem; letter-spacing: -0.02em;
    }
    .newsletter p {
      color: rgba(199,208,232,0.7); line-height: 1.7; margin-bottom: 1.5rem;
    }
    .newsletter-stats {
      display: flex; gap: 2rem; font-size: 0.75rem;
      color: rgba(199,208,232,0.5); text-transform: uppercase;
      letter-spacing: 0.1em;
    }
    .newsletter-stats strong { color: var(--copper-light); }

    .newsletter-form {
      background: rgba(16,27,60,0.6); border: 1px solid rgba(199,208,232,0.15);
      border-radius: 16px; padding: 2rem; backdrop-filter: blur(12px);
    }
    .newsletter-form input {
      width: 100%; padding: 14px 16px; border-radius: 8px;
      border: 1px solid rgba(199,208,232,0.2);
      background: rgba(255,255,255,0.05); color: #fff;
      font-size: 1rem; margin-bottom: 1rem;
      outline: none; transition: border-color 0.3s;
    }
    .newsletter-form input::placeholder { color: rgba(199,208,232,0.4); }
    .newsletter-form input:focus { border-color: var(--copper); }

    /* Responsive */
    @media (max-width: 768px) {
      .kpi-strip { grid-template-columns: repeat(2, 1fr); }
      .method-grid { grid-template-columns: repeat(2, 1fr); }
      .newsletter { grid-template-columns: 1fr; }
      .reports-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 480px) {
      .kpi-strip { grid-template-columns: 1fr; }
      .method-grid { grid-template-columns: 1fr; }
      .hero-ctas { flex-direction: column; }
      .btn { width: 100%; justify-content: center; }
    }

    /* Scroll reveal */
    .reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.6s ease, transform 0.6s ease; }
    .reveal.visible { opacity: 1; transform: translateY(0); }
  </style>

  <!-- ═══ HERO ═══ -->
  <section class="hero">
    <div class="hero-inner">
      <span class="hero-kicker"><span class="dot"></span> Est. 2019 · Independent · Evidence-Based</span>
      <h1 class="hero-title">Where <em>AI claims</em> meet verified evidence.</h1>
      <p class="hero-sub">Independent benchmarks, deployment analysis, and governance research for enterprise AI — from model evaluation to production readiness. Cited by 240+ publications.</p>
      <div class="hero-ctas">
        <a href="/insights" class="btn btn-primary">Read Our Research →</a>
        <a href="/methodology" class="btn btn-outline">Our Methodology</a>
      </div>

      <div class="kpi-strip">
        {kpis.map(kpi => (
          <div class="kpi-item">
            <div class="kpi-value">{kpi.value}</div>
            <div class="kpi-label">{kpi.label}</div>
            <div class="kpi-sub">{kpi.sub}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ PRESS STRIP ═══ -->
  <div class="press-strip">
    <div class="container">
      <p class="press-label">As featured in</p>
      <div class="press-logos">
        {pressLogos.map(logo => (
          <a href={`https://www.${logo.name.toLowerCase().replace(/ /g, '')}.com`} target="_blank" rel="noopener" class="press-logo-link">
            <img src={`/logos/${logo.file}`} alt={logo.name} class="press-logo-img" loading="lazy" />
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- ═══ RESEARCH REPORTS ═══ -->
  <section class="section section-dark">
    <div class="container">
      <span class="section-label">Latest Intelligence</span>
      <h2 class="section-title">Recent AI & Machine Learning research</h2>
      <div class="reports-grid">
        {posts.map((post, i) => (
          <a href={`/research/${post.id}`} class="report-card">
            <img class="report-img" src={post.data.heroImage || `/logos/og-image.svg`} alt={post.data.title} loading="lazy" />
            <div class="report-body">
              <span class="report-tag">{post.data.outputFormat || 'Report'}</span>
              <h3 class="report-title">{post.data.title}</h3>
              <p class="report-desc">{post.data.description}</p>
              <div class="report-meta">
                <span>{post.data.author}</span>
                <span>{new Date(post.data.publishDate).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
      <div style="text-align:center;margin-top:3rem;">
        <a href="/insights" class="btn btn-primary">View All Research →</a>
      </div>
    </div>
  </section>

  <!-- ═══ METHODOLOGY ═══ -->
  <section class="section section-dark" style="padding-top:4rem;">
    <div class="container">
      <span class="section-label">How We Work</span>
      <h2 class="section-title">Rigor, not opinions.</h2>
      <div class="method-grid">
        {methodology.map(m => (
          <div class="method-step">
            <div class="method-num">{m.step}</div>
            <h3>{m.title}</h3>
            <p>{m.desc}</p>
          </div>
        ))}
      </div>
      <div style="text-align:center;margin-top:2rem;">
        <a href="/methodology" style="color:var(--copper-light);text-decoration:none;font-size:0.875rem;">Full methodology →</a>
      </div>
    </div>
  </section>

  <!-- ═══ NEWSLETTER ═══ -->
  <section class="section" style="background:linear-gradient(135deg, #0A1128, #111D3A);">
    <div class="container newsletter">
      <div>
        <span class="section-label">The Briefing</span>
        <h2>Get the AI & Machine Learning Briefing</h2>
        <p>Weekly research digest with key findings, market signals, and analysis — delivered to your inbox. No noise. No sponsored content. Ever.</p>
        <div class="newsletter-stats">
          <span><strong>2,400+</strong> subscribers</span>
          <span><strong>82%</strong> open rate</span>
          <span><strong>Free</strong> forever</span>
        </div>
      </div>
      <div class="newsletter-form">
        <form id="newsletter-form">
          <input type="email" name="email" placeholder="Your email address" required />
          <button type="submit" class="btn btn-primary" style="width:100%;">Subscribe to The Briefing →</button>
          <p style="font-size:0.75rem;color:rgba(199,208,232,0.4);margin-top:0.75rem;text-align:center;">No spam. Unsubscribe anytime.</p>
        </form>
      </div>
    </div>
  </section>

  <script>
    // Scroll reveal
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

    // Newsletter form
    var nlForm = document.getElementById('newsletter-form');
    if (nlForm) {
      nlForm.addEventListener('submit', function(e) {
        e.preventDefault();
        var email = nlForm.querySelector('input[type="email"]').value;
        var btn = nlForm.querySelector('button[type="submit"]');
        var origText = btn.textContent;
        btn.textContent = 'Subscribing...';
        btn.disabled = true;
        fetch('https://research-api.n311311.workers.dev/api/form/newsletter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            site: 'hargroveresearch.com',
            name: 'Newsletter Subscriber',
            email: email,
            message: 'Subscribe to Research Briefing',
            website: ''
          })
        }).then(function(r) { return r.json(); }).then(function(d) {
          btn.textContent = '✓ Subscribed!';
          nlForm.querySelector('input[type="email"]').value = '';
          setTimeout(function() { btn.textContent = origText; btn.disabled = false; }, 3000);
        }).catch(function() {
          btn.textContent = 'Error — try again';
          setTimeout(function() { btn.textContent = origText; btn.disabled = false; }, 3000);
        });
      });
    }

    // Counter animation
    document.querySelectorAll('[data-count]').forEach(el => {
      const target = parseFloat(el.dataset.count);
      const obs = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            let start = performance.now();
            function tick(now) {
              const p = Math.min((now - start) / 1600, 1);
              const eased = 1 - Math.pow(1 - p, 3);
              el.textContent = (target * eased).toFixed(1);
              if (p < 1) requestAnimationFrame(tick);
            }
            requestAnimationFrame(tick);
            obs.unobserve(el);
          }
        });
      }, { threshold: 0.4 });
      obs.observe(el);
    });
  </script>
</BaseLayout>
