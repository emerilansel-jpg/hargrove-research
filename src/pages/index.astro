---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustBadge from '../components/TrustBadge.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('research'))
  .filter(p => p.data.status === 'Live')
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Home" description="Independent benchmarks, deployment analysis, and governance research for enterprise AI — from model evaluation to production readiness.">

  <!-- ═══ HERO ═══ -->
  <section class="hero">
    <div class="hero__bg">
      <div class="hero__bg-grid"></div>
      <canvas class="hero__bg-canvas" id="hero-canvas" aria-hidden="true"></canvas>
      <div class="hero__bg-noise"></div>
    </div>
    <div class="hero__orb hero__orb--1"></div>
    <div class="hero__orb hero__orb--2"></div>
    <div class="hero__orb hero__orb--3"></div>

    <div class="container hero__inner">
      <div class="hero__content">
        <span class="hero__kicker">
          <span class="pulse-dot pulse-dot--copper"></span>
          Est. 2019 &middot; Independent &middot; Evidence-Based
        </span>
        <h1 class="hero__title">
          Where <em>AI claims</em><br/>
          meet verified evidence.
        </h1>
        <p class="hero__sub">
          Independent benchmarks, deployment analysis, and governance research for enterprise AI — from model evaluation to production readiness. Cited by 240+ publications. Trusted by the Fortune 500.
        </p>
        <div class="hero__ctas">
          <a href="/insights" class="btn">Read Our Research</a>
          <a href="/methodology" class="btn btn-outline--light">Our Methodology</a>
        </div>
        <div class="hero__badges">
          <TrustBadge icon="&#10003;" label="No pay-to-rank" />
          <TrustBadge icon="&#9670;" label="Published methodology" />
          <TrustBadge icon="&#9670;" label="Named reviewers" />
          <TrustBadge icon="&#8634;" label="Open corrections" />
        </div>
      </div>

      <!-- Animated benchmark card -->
      <div class="hero__visual">
        <div class="hero-card">
          <div class="hero-card__header">
            <span class="hero-card__badge"><span class="pulse-dot pulse-dot--green" style="margin-right:4px"></span>Live Benchmark</span>
            <span class="hero-card__timestamp mono" id="hero-timestamp">—</span>
          </div>
          <h3 class="hero-card__title">Enterprise AI Readiness Index</h3>
          <p class="hero-card__subtitle">Q3 2026 &middot; 24 platforms tracked</p>

          <div class="hero-card__metrics">
            <div class="hero-metric">
              <span class="hero-metric__num">
                <span data-count="94.2">0</span><span class="unit">%</span>
                <span class="hero-metric__trend">&#9650;2.4</span>
              </span>
              <span class="hero-metric__label">Reasoning Accuracy</span>
            </div>
            <div class="hero-metric">
              <span class="hero-metric__num">
                <span data-count="3.7">0</span><span class="unit">&times;</span>
                <span class="hero-metric__trend">&#9650;0.3</span>
              </span>
              <span class="hero-metric__label">Cost Efficiency Gap</span>
            </div>
            <div class="hero-metric">
              <span class="hero-metric__num">
                <span data-count="67">0</span><span class="unit">%</span>
                <span class="hero-metric__trend">&#9650;12</span>
              </span>
              <span class="hero-metric__label">F500 Adoption</span>
            </div>
            <div class="hero-metric">
              <span class="hero-metric__num">
                <span data-count="4.2">0</span><span class="unit">B</span>
                <span class="hero-metric__trend hero-metric__trend--down">&#9660;0.8</span>
              </span>
              <span class="hero-metric__label">H1 Capital Deployed</span>
            </div>
          </div>

          <div class="hero-card__chart">
            <div class="hero-card__chart-label">
              <span>Readiness Score &middot; Trailing 12M</span>
              <span class="mono" style="color:var(--copper-300)">+18.2%</span>
            </div>
            <svg viewBox="0 0 380 90" preserveAspectRatio="none" aria-hidden="true">
              <defs>
                <linearGradient id="chartFill" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#E09543" stop-opacity="0.4"/>
                  <stop offset="100%" stop-color="#E09543" stop-opacity="0"/>
                </linearGradient>
                <linearGradient id="chartStroke" x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0%" stop-color="#E09543"/>
                  <stop offset="100%" stop-color="#8B7CF9"/>
                </linearGradient>
              </defs>
              <g opacity="0.15" stroke="#C7D0E8" stroke-width="0.5">
                <line x1="0" y1="22" x2="380" y2="22"/>
                <line x1="0" y1="45" x2="380" y2="45"/>
                <line x1="0" y1="68" x2="380" y2="68"/>
              </g>
              <path d="M0,68 L30,62 L60,65 L90,55 L120,58 L150,48 L180,52 L210,40 L240,44 L270,32 L300,36 L330,24 L360,28 L380,18 L380,90 L0,90 Z"
                    fill="url(#chartFill)"/>
              <path d="M0,68 L30,62 L60,65 L90,55 L120,58 L150,48 L180,52 L210,40 L240,44 L270,32 L300,36 L330,24 L360,28 L380,18"
                    fill="none" stroke="url(#chartStroke)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                    stroke-dasharray="1000" stroke-dashoffset="1000">
                <animate attributeName="stroke-dashoffset" from="1000" to="0" dur="2.4s" begin="0.6s" fill="freeze" calcMode="spline" keySplines="0.16 1 0.3 1"/>
              </path>
              <circle cx="380" cy="18" r="3.5" fill="#E09543">
                <animate attributeName="r" values="3.5;5;3.5" dur="2s" repeatCount="indefinite"/>
                <animate attributeName="opacity" values="1;0.6;1" dur="2s" repeatCount="indefinite"/>
              </circle>
            </svg>
          </div>
        </div>

        <!-- Floating accent chips -->
        <div class="hero-chip hero-chip--1"><strong>GPT-5</strong> 94.2% reasoning</div>
        <div class="hero-chip hero-chip--2"><strong>RAG</strong> 3.7&times; cost edge</div>
        <div class="hero-chip hero-chip--3"><strong>+240</strong> press citations</div>
      </div>
    </div>
  </section>

  <!-- ═══ SIGNAL BAR ═══ -->
  <div class="signal-bar" role="marquee" aria-label="Latest research signals">
    <div class="signal-bar__label">
      <span class="pulse-dot pulse-dot--green"></span>
      Live Feed
    </div>
    <div class="signal-bar__track">
      <div class="signal-bar__content">
        <span class="signal-bar__item"><strong>Benchmark</strong> GPT-5 Enterprise: 94.2% on structured reasoning</span>
        <span class="signal-bar__item"><strong>Policy</strong> EU AI Act &middot; New compliance requirements for 2026</span>
        <span class="signal-bar__item"><strong>Capital</strong> $4.2B invested in AI agent infrastructure &middot; H1 2026</span>
        <span class="signal-bar__item"><strong>Analysis</strong> RAG vs Fine-Tuning: 3.7&times; efficiency gap</span>
        <span class="signal-bar__item"><strong>Adoption</strong> 67% of F500 now run dedicated AI governance teams</span>
        <span class="signal-bar__item"><strong>Multi-Modal</strong> Vision-language benchmarks up 23% QoQ</span>
        <span class="signal-bar__item"><strong>Benchmark</strong> GPT-5 Enterprise: 94.2% on structured reasoning</span>
        <span class="signal-bar__item"><strong>Policy</strong> EU AI Act &middot; New compliance requirements for 2026</span>
        <span class="signal-bar__item"><strong>Capital</strong> $4.2B invested in AI agent infrastructure &middot; H1 2026</span>
        <span class="signal-bar__item"><strong>Analysis</strong> RAG vs Fine-Tuning: 3.7&times; efficiency gap</span>
        <span class="signal-bar__item"><strong>Adoption</strong> 67% of F500 now run dedicated AI governance teams</span>
        <span class="signal-bar__item"><strong>Multi-Modal</strong> Vision-language benchmarks up 23% QoQ</span>
      </div>
    </div>
  </div>

  <!-- ═══ PRESS STRIP ═══ -->
  <section class="press-strip">
    <div class="container">
      <p class="press-strip__label reveal">As featured in</p>
      <div class="press-strip__logos reveal" data-delay="1">
        <span class="press-logo">Financial Times</span>
        <span class="press-logo">Bloomberg</span>
        <span class="press-logo">Wall Street Journal</span>
        <span class="press-logo">Reuters</span>
        <span class="press-logo">The Economist</span>
        <span class="press-logo">TechCrunch</span>
      </div>
    </div>
  </section>

  <!-- ═══ STATS ═══ -->
  <section class="stats-section">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-card reveal">
          <span class="stat-card__num"><span data-count="500">0</span><span class="suffix">+</span></span>
          <span class="stat-card__label">Models Evaluated</span>
          <span class="stat-card__meta">Across 42 benchmark suites</span>
          <svg class="stat-card__spark" viewBox="0 0 100 24" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0,18 L12,16 L24,17 L36,13 L48,14 L60,10 L72,11 L84,6 L100,4" fill="none" stroke="#C97B2D" stroke-width="1.5" stroke-linecap="round"/>
            <circle cx="100" cy="4" r="2" fill="#C97B2D"/>
          </svg>
        </div>
        <div class="stat-card reveal" data-delay="1">
          <span class="stat-card__num"><span data-count="42">0</span></span>
          <span class="stat-card__label">Enterprise Benchmarks</span>
          <span class="stat-card__meta">Published, peer-reviewed</span>
          <svg class="stat-card__spark" viewBox="0 0 100 24" preserveAspectRatio="none" aria-hidden="true">
            <rect x="2" y="14" width="6" height="8" fill="#C97B2D" opacity="0.4" rx="1"/>
            <rect x="12" y="11" width="6" height="11" fill="#C97B2D" opacity="0.5" rx="1"/>
            <rect x="22" y="13" width="6" height="9" fill="#C97B2D" opacity="0.5" rx="1"/>
            <rect x="32" y="9" width="6" height="13" fill="#C97B2D" opacity="0.6" rx="1"/>
            <rect x="42" y="10" width="6" height="12" fill="#C97B2D" opacity="0.6" rx="1"/>
            <rect x="52" y="7" width="6" height="15" fill="#C97B2D" opacity="0.7" rx="1"/>
            <rect x="62" y="8" width="6" height="14" fill="#C97B2D" opacity="0.7" rx="1"/>
            <rect x="72" y="5" width="6" height="17" fill="#C97B2D" opacity="0.8" rx="1"/>
            <rect x="82" y="6" width="6" height="16" fill="#C97B2D" opacity="0.85" rx="1"/>
            <rect x="92" y="3" width="6" height="19" fill="#C97B2D" rx="1"/>
          </svg>
        </div>
        <div class="stat-card reveal" data-delay="2">
          <span class="stat-card__num"><span data-count="96">0</span><span class="suffix">%</span></span>
          <span class="stat-card__label">Prediction Accuracy</span>
          <span class="stat-card__meta">Trailing 24-month window</span>
          <svg class="stat-card__spark" viewBox="0 0 100 24" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0,20 Q25,18 50,10 T100,2" fill="none" stroke="#6D5DF6" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M0,20 Q25,18 50,10 T100,2 L100,24 L0,24 Z" fill="#6D5DF6" opacity="0.1"/>
            <circle cx="100" cy="2" r="2" fill="#6D5DF6"/>
          </svg>
        </div>
        <div class="stat-card reveal" data-delay="3">
          <span class="stat-card__num"><span data-count="180">0</span><span class="suffix">+</span></span>
          <span class="stat-card__label">Vendor Assessments</span>
          <span class="stat-card__meta">Disclosed &amp; on-the-record</span>
          <svg class="stat-card__spark" viewBox="0 0 100 24" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0,16 L14,14 L28,15 L42,10 L56,12 L70,7 L84,8 L100,3" fill="none" stroke="#C97B2D" stroke-width="1.5" stroke-linecap="round"/>
            <circle cx="100" cy="3" r="2" fill="#C97B2D"/>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ FEATURED REPORT ═══ -->
  <section class="section section--dark">
    <div class="container report-spotlight">
      <div class="report-spotlight__info reveal">
        <span class="report-spotlight__label">Featured Report &middot; Q3 2026</span>
        <h2 class="text-balance">Enterprise AI Readiness Index</h2>
        <p>
          Comprehensive evaluation of 24 enterprise AI platforms across deployment speed,
          governance readiness, model flexibility, and production reliability. Methodology
          published. Conflicts disclosed. Data on-the-record.
        </p>
        <div class="report-spotlight__meta">
          <span>Research Team</span>
          <span>48 pages</span>
          <span>24 vendors scored</span>
          <span>Jul 2026</span>
        </div>
        <div style="display:flex;gap:1rem;flex-wrap:wrap;">
          <a href="/insights" class="btn">Read the Report</a>
          <a href="/methodology" class="btn btn-outline--light">Methodology</a>
        </div>
      </div>

      <div class="report-spotlight__card reveal" data-delay="1">
        <div class="report-mockup">
          <span class="report-mockup__badge">AI &amp; Machine Learning</span>
          <h3 class="report-mockup__title">Enterprise AI Readiness Index &middot; Q3 2026</h3>
          <div class="report-mockup__divider"></div>
          <div class="report-mockup__bars">
            <div class="report-mockup__bar-row">
              <span class="report-mockup__bar-label">Model Governance</span>
              <div class="report-mockup__bar-track"><div class="report-mockup__bar-fill" style="width:89%"></div></div>
              <span class="report-mockup__bar-val">89</span>
            </div>
            <div class="report-mockup__bar-row">
              <span class="report-mockup__bar-label">Deployment Speed</span>
              <div class="report-mockup__bar-track"><div class="report-mockup__bar-fill" style="width:76%"></div></div>
              <span class="report-mockup__bar-val">76</span>
            </div>
            <div class="report-mockup__bar-row">
              <span class="report-mockup__bar-label">Cost Efficiency</span>
              <div class="report-mockup__bar-track"><div class="report-mockup__bar-fill" style="width:68%"></div></div>
              <span class="report-mockup__bar-val">68</span>
            </div>
            <div class="report-mockup__bar-row">
              <span class="report-mockup__bar-label">Enterprise Support</span>
              <div class="report-mockup__bar-track"><div class="report-mockup__bar-fill" style="width:82%"></div></div>
              <span class="report-mockup__bar-val">82</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ METHODOLOGY VISUAL ═══ -->
  <section class="section">
    <div class="container">
      <div class="section__header reveal">
        <div>
          <span class="section__label">How We Work</span>
          <h2 class="text-balance">Rigor, not opinions.</h2>
        </div>
        <a href="/methodology" class="link-arrow">Full methodology</a>
      </div>

      <div class="method-flow reveal" data-delay="1">
        <div class="method-step">
          <div class="method-step__icon">
            <svg viewBox="0 0 40 40" fill="none" aria-hidden="true">
              <rect x="6" y="8" width="28" height="24" rx="3" stroke="currentColor" stroke-width="1.5"/>
              <line x1="12" y1="15" x2="28" y2="15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <line x1="12" y1="20" x2="24" y2="20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <line x1="12" y1="25" x2="26" y2="25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <circle cx="30" cy="25" r="2" fill="#E09543"/>
            </svg>
          </div>
          <span class="method-step__num mono">01</span>
          <h3>Define criteria</h3>
          <p>Fixed &amp; published before any vendor is named.</p>
        </div>
        <div class="method-connector" aria-hidden="true"></div>
        <div class="method-step">
          <div class="method-step__icon">
            <svg viewBox="0 0 40 40" fill="none" aria-hidden="true">
              <circle cx="20" cy="20" r="12" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="20" cy="20" r="5" fill="#E09543" opacity="0.3"/>
              <circle cx="20" cy="20" r="2.5" fill="#E09543"/>
              <line x1="20" y1="8" x2="20" y2="14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <line x1="32" y1="20" x2="26" y2="20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <line x1="20" y1="32" x2="20" y2="26" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <line x1="8" y1="20" x2="14" y2="20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <span class="method-step__num mono">02</span>
          <h3>Collect evidence</h3>
          <p>Primary data, interviews, filings — on the record.</p>
        </div>
        <div class="method-connector" aria-hidden="true"></div>
        <div class="method-step">
          <div class="method-step__icon">
            <svg viewBox="0 0 40 40" fill="none" aria-hidden="true">
              <path d="M8 30 L8 14 L16 10 L24 14 L32 10 L32 26 L24 30 L16 26 L8 30 Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
              <circle cx="20" cy="20" r="3" fill="#E09543"/>
              <path d="M14 16 L20 20 L26 16" stroke="#E09543" stroke-width="1.5"/>
            </svg>
          </div>
          <span class="method-step__num mono">03</span>
          <h3>Independent review</h3>
          <p>Named reviewers evaluate methodology &amp; evidence.</p>
        </div>
        <div class="method-connector" aria-hidden="true"></div>
        <div class="method-step">
          <div class="method-step__icon">
            <svg viewBox="0 0 40 40" fill="none" aria-hidden="true">
              <rect x="8" y="10" width="24" height="20" rx="2" stroke="currentColor" stroke-width="1.5"/>
              <path d="M14 18 L18 22 L26 14" stroke="#E09543" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <line x1="14" y1="26" x2="26" y2="26" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <span class="method-step__num mono">04</span>
          <h3>Publish &amp; disclose</h3>
          <p>Methodology, limitations, conflicts — all public.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ LATEST INSIGHTS ═══ -->
  <section class="section">
    <div class="container">
      <div class="section__header reveal">
        <div>
          <span class="section__label">Latest Intelligence</span>
          <h2 class="text-balance">Recent AI &amp; Machine Learning research</h2>
        </div>
        <a href="/insights" class="link-arrow">View all insights</a>
      </div>
      {posts.length > 0 ? (
        <div class="insights-grid">
          {posts.map((post, i) => (
            <article class="insight-card reveal" data-delay={String((i % 3) + 1)}>
              <span class="insight-card__tag">{post.data.outputFormat || 'Report'}</span>
              <h3><a href={'/research/' + post.id}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
              <span class="insight-card__meta">
                {post.data.author} &middot; {new Date(post.data.publishDate).toLocaleDateString('en-US', { month:'short', year:'numeric' })}
              </span>
            </article>
          ))}
        </div>
      ) : (
        <div class="insights-grid">
          <article class="insight-card reveal" data-delay="1">
            <span class="insight-card__tag">Benchmark</span>
            <h3><a href="/insights">Foundation Model Cost-Performance Matrix 2026</a></h3>
            <p>Total-cost-of-ownership analysis across 18 frontier models, measured against 12 production workloads.</p>
            <span class="insight-card__meta">Research Team &middot; Jul 2026</span>
          </article>
          <article class="insight-card reveal" data-delay="2">
            <span class="insight-card__tag">Analysis</span>
            <h3><a href="/insights">AI Agent Infrastructure: Who Owns the Orchestration Layer?</a></h3>
            <p>Value-chain mapping across 47 vendors, with exclusive deployment data from 120 enterprise rollouts.</p>
            <span class="insight-card__meta">Research Team &middot; Jun 2026</span>
          </article>
          <article class="insight-card reveal" data-delay="3">
            <span class="insight-card__tag">Primer</span>
            <h3><a href="/insights">RAG Architecture Patterns for Regulated Industries</a></h3>
            <p>Design patterns that satisfy SEC, HIPAA, and GDPR constraints — with reference implementations.</p>
            <span class="insight-card__meta">Research Team &middot; Jun 2026</span>
          </article>
        </div>
      )}
    </div>
  </section>

  <!-- ═══ INSIGHTS FEED ═══ -->
  <section class="section section--soft">
    <div class="container">
      <div class="reveal">
        <span class="section__label">Market Commentary</span>
        <h2 class="text-balance" style="margin-bottom:2.5rem;">Insights feed</h2>
      </div>
      <div class="feed-list reveal" data-delay="1">
        <a href="/insights" class="feed-item">
          <span class="feed-item__tag">Benchmark</span>
          <span class="feed-item__title">Foundation Model Cost-Performance Matrix 2026</span>
          <span class="feed-item__date">Jul 2026</span>
        </a>
        <a href="/insights" class="feed-item">
          <span class="feed-item__tag">Analysis</span>
          <span class="feed-item__title">AI Agent Infrastructure: Who Owns the Orchestration Layer?</span>
          <span class="feed-item__date">Jun 2026</span>
        </a>
        <a href="/insights" class="feed-item">
          <span class="feed-item__tag">Primer</span>
          <span class="feed-item__title">RAG Architecture Patterns for Regulated Industries</span>
          <span class="feed-item__date">Jun 2026</span>
        </a>
        <a href="/insights" class="feed-item">
          <span class="feed-item__tag">Report</span>
          <span class="feed-item__title">LLM Fine-Tuning Economics: Build vs Buy Decision Framework</span>
          <span class="feed-item__date">May 2026</span>
        </a>
        <a href="/insights" class="feed-item">
          <span class="feed-item__tag">Benchmark</span>
          <span class="feed-item__title">Multi-Modal AI: Vision-Language Model Enterprise Readiness</span>
          <span class="feed-item__date">May 2026</span>
        </a>
        <a href="/insights" class="feed-item">
          <span class="feed-item__tag">Analysis</span>
          <span class="feed-item__title">AI Safety &amp; Alignment: Enterprise Compliance Landscape</span>
          <span class="feed-item__date">Apr 2026</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ NEWSLETTER ═══ -->
  <section class="section section--dark">
    <div class="container newsletter-section">
      <div class="newsletter-section__content reveal">
        <span class="section__label">The Briefing</span>
        <h2 class="text-balance">Get the <em style="font-style:italic;color:var(--copper-300);font-weight:400;">AI &amp; Machine Learning</em> Briefing</h2>
        <p>Weekly research digest with key findings, market signals, and analysis — delivered to your inbox. No noise. No sponsored content. Ever.</p>
        <div class="newsletter-section__proof">
          <span><strong>2,400+</strong> subscribers</span>
          <span><strong>82%</strong> open rate</span>
          <span><strong>Free</strong> forever</span>
        </div>

        <!-- Email preview mockup -->
