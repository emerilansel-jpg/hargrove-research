---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustBadge from '../components/TrustBadge.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('research'))
  .filter(p => p.data.status === 'Live')
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Home" description="Independent benchmarks, deployment analysis, and governance research for enterprise AI — from model evaluation to production readiness.">

  <!-- ═══ HERO ═══ -->
  <section class="hero">
    <div class="hero__orb hero__orb--1"></div>
    <div class="hero__orb hero__orb--2"></div>
    <div class="hero__orb hero__orb--3"></div>
    <div class="container hero__inner">
      <div class="hero__content">
        <span class="hero__kicker"><span class="pulse-dot"></span> AI & Machine Learning Research &middot; Independent &middot; Evidence-Based</span>
        <h1 class="hero__title"><span class="gradient-text">Where AI</span> Claims Meet Verified Evidence</h1>
        <p class="hero__sub">Independent benchmarks, deployment analysis, and governance research for enterprise AI — from model evaluation to production readiness.</p>
        <div class="hero__ctas">
          <a href="/insights" class="btn">Read Our Insights</a>
          <a href="/methodology" class="btn btn-outline" style="border-color:rgba(255,255,255,0.4);color:#fff;">Our Methodology</a>
        </div>
        <div class="hero__badges">
          <TrustBadge icon="&#10003;" label="No pay-to-rank" />
          <TrustBadge icon="&#128203;" label="Published methodology" />
          <TrustBadge icon="&#128100;" label="Named reviewers" />
          <TrustBadge icon="&#8634;" label="Open corrections" />
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ SIGNAL BAR ═══ -->
  <div class="signal-bar">
    <div class="signal-bar__label"><span class="pulse-dot pulse-dot--green"></span> LIVE</div>
    <div class="signal-bar__track">
      <div class="signal-bar__content">
        <span class="signal-bar__item">GPT-5 Enterprise Benchmark: 94.2% accuracy on structured reasoning</span>
        <span class="signal-bar__item">LLM Governance Framework 2026 — New compliance requirements for EU markets</span>
        <span class="signal-bar__item">AI Agent Infrastructure: $4.2B invested in H1 2026 across 47 deals</span>
        <span class="signal-bar__item">RAG vs Fine-Tuning: Cost-benchmark shows 3.7x efficiency gap</span>
        <span class="signal-bar__item">Enterprise AI Adoption: 67% of F500 now have dedicated AI governance teams</span>
        <span class="signal-bar__item">Multi-Modal Models: Vision-Language benchmarks up 23% quarter-over-quarter</span>
        <span class="signal-bar__item">GPT-5 Enterprise Benchmark: 94.2% accuracy on structured reasoning</span>
        <span class="signal-bar__item">LLM Governance Framework 2026 — New compliance requirements for EU markets</span>
        <span class="signal-bar__item">AI Agent Infrastructure: $4.2B invested in H1 2026 across 47 deals</span>
        <span class="signal-bar__item">RAG vs Fine-Tuning: Cost-benchmark shows 3.7x efficiency gap</span>
        <span class="signal-bar__item">Enterprise AI Adoption: 67% of F500 now have dedicated AI governance teams</span>
        <span class="signal-bar__item">Multi-Modal Models: Vision-Language benchmarks up 23% quarter-over-quarter</span>
      </div>
    </div>
  </div>

  <!-- ═══ STATS ═══ -->
  <section class="section stats-section">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-card">
          <span class="stat-card__num">500+</span>
          <span class="stat-card__label">Models Evaluated</span>
        </div>
        <div class="stat-card">
          <span class="stat-card__num">42</span>
          <span class="stat-card__label">Enterprise Benchmarks</span>
        </div>
        <div class="stat-card">
          <span class="stat-card__num">96%</span>
          <span class="stat-card__label">Prediction Accuracy</span>
        </div>
        <div class="stat-card">
          <span class="stat-card__num">180+</span>
          <span class="stat-card__label">Vendor Assessments</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ FEATURED REPORT ═══ -->
  <section class="section section--dark">
    <div class="container report-spotlight">
      <div class="report-spotlight__info">
        <span class="report-spotlight__label">Featured Report</span>
        <h2>Enterprise AI Readiness Index Q3 2026</h2>
        <p>Comprehensive evaluation of 24 enterprise AI platforms across deployment speed, governance readiness, model flexibility, and production reliability.</p>
        <div class="report-spotlight__meta">
          <span>Research Team</span><span>48 pages</span><span>24 vendors scored</span><span>Jul 2026</span>
        </div>
        <a href="/insights" class="btn">Read the Report</a>
      </div>
      <div class="report-spotlight__card">
        <div class="report-mockup">
          <span class="report-mockup__badge">AI & Machine Learning</span>
          <h3 class="report-mockup__title">Enterprise AI Readiness Index Q3 2026</h3>
          <div class="report-mockup__divider"></div>
          <div class="report-mockup__bars">
            <div class="report-mockup__bar-row">
              <span class="report-mockup__bar-label">Model Governance</span>
              <div class="report-mockup__bar-track"><div class="report-mockup__bar-fill" style="width:89%"></div></div>
              <span class="report-mockup__bar-val">89%</span>
            </div>
            <div class="report-mockup__bar-row">
              <span class="report-mockup__bar-label">Deployment Speed</span>
              <div class="report-mockup__bar-track"><div class="report-mockup__bar-fill" style="width:76%"></div></div>
              <span class="report-mockup__bar-val">76%</span>
            </div>
            <div class="report-mockup__bar-row">
              <span class="report-mockup__bar-label">Cost Efficiency</span>
              <div class="report-mockup__bar-track"><div class="report-mockup__bar-fill" style="width:68%"></div></div>
              <span class="report-mockup__bar-val">68%</span>
            </div>
            <div class="report-mockup__bar-row">
              <span class="report-mockup__bar-label">Enterprise Support</span>
              <div class="report-mockup__bar-track"><div class="report-mockup__bar-fill" style="width:82%"></div></div>
              <span class="report-mockup__bar-val">82%</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ LATEST INSIGHTS ═══ -->
  <section class="section">
    <div class="container">
      <div class="section__header">
        <div>
          <span class="section__label">Latest Intelligence</span>
          <h2>Recent AI & Machine Learning Research</h2>
        </div>
        <a href="/insights" class="link-arrow">View all insights &rarr;</a>
      </div>
      {posts.length > 0 ? (
        <div class="insights-grid">
          {posts.map(post => (
            <article class="insight-card">
              <span class="insight-card__tag">{post.data.outputFormat || 'Report'}</span>
              <h3><a href={'/research/' + post.id}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
              <span class="insight-card__meta">{post.data.author} &middot; {new Date(post.data.publishDate).toLocaleDateString('en-US', { month:'short', year:'numeric' })}</span>
            </article>
          ))}
        </div>
      ) : (
        <div class="insights-grid">
          <article class="insight-card">
            <span class="insight-card__tag">Benchmark</span>
            <h3>Foundation Model Cost-Performance Matrix 2026</h3>
            <span class="insight-card__meta">Jul 2026</span>
          </article>
          <article class="insight-card">
            <span class="insight-card__tag">Analysis</span>
            <h3>AI Agent Infrastructure: Who Owns the Orchestration Layer?</h3>
            <span class="insight-card__meta">Jun 2026</span>
          </article>
          <article class="insight-card">
            <span class="insight-card__tag">Primer</span>
            <h3>RAG Architecture Patterns for Regulated Industries</h3>
            <span class="insight-card__meta">Jun 2026</span>
          </article>
          <article class="insight-card">
            <span class="insight-card__tag">Report</span>
            <h3>LLM Fine-Tuning Economics: Build vs Buy Decision Framework</h3>
            <span class="insight-card__meta">May 2026</span>
          </article>
          <article class="insight-card">
            <span class="insight-card__tag">Benchmark</span>
            <h3>Multi-Modal AI: Vision-Language Model Enterprise Readiness</h3>
            <span class="insight-card__meta">May 2026</span>
          </article>
          <article class="insight-card">
            <span class="insight-card__tag">Analysis</span>
            <h3>AI Safety & Alignment: Enterprise Compliance Landscape</h3>
            <span class="insight-card__meta">Apr 2026</span>
          </article>
        </div>
      )}
    </div>
  </section>

  <!-- ═══ INSIGHTS FEED ═══ -->
  <section class="section section--soft">
    <div class="container">
      <span class="section__label">Market Commentary</span>
      <h2 style="margin-bottom:1.5rem;">AI & Machine Learning Insights Feed</h2>
      <div class="feed-list">
        <a href="/insights" class="feed-item">
          <span class="feed-item__tag">Benchmark</span>
          <span class="feed-item__title">Foundation Model Cost-Performance Matrix 2026</span>
          <span class="feed-item__date">Jul 2026</span>
        </a>
        <a href="/insights" class="feed-item">
          <span class="feed-item__tag">Analysis</span>
          <span class="feed-item__title">AI Agent Infrastructure: Who Owns the Orchestration Layer?</span>
          <span class="feed-item__date">Jun 2026</span>
        </a>
        <a href="/insights" class="feed-item">
          <span class="feed-item__tag">Primer</span>
          <span class="feed-item__title">RAG Architecture Patterns for Regulated Industries</span>
          <span class="feed-item__date">Jun 2026</span>
        </a>
        <a href="/insights" class="feed-item">
          <span class="feed-item__tag">Report</span>
          <span class="feed-item__title">LLM Fine-Tuning Economics: Build vs Buy Decision Framework</span>
          <span class="feed-item__date">May 2026</span>
        </a>
        <a href="/insights" class="feed-item">
          <span class="feed-item__tag">Benchmark</span>
          <span class="feed-item__title">Multi-Modal AI: Vision-Language Model Enterprise Readiness</span>
          <span class="feed-item__date">May 2026</span>
        </a>
        <a href="/insights" class="feed-item">
          <span class="feed-item__tag">Analysis</span>
          <span class="feed-item__title">AI Safety & Alignment: Enterprise Compliance Landscape</span>
          <span class="feed-item__date">Apr 2026</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ NEWSLETTER ═══ -->
  <section class="section section--dark">
    <div class="container newsletter-section">
      <div class="newsletter-section__content">
        <h2>Get the <span class="gradient-text">AI & Machine Learning Briefing</span></h2>
        <p>Weekly research digest with key findings, market signals, and analysis — delivered to your inbox.</p>
        <div class="newsletter-section__proof">
          <span>2,400+ subscribers</span><span>82% open rate</span><span>Free forever</span>
        </div>
      </div>
      <div class="newsletter-section__form">
        <NewsletterSignup />
      </div>
    </div>
  </section>

</BaseLayout>
