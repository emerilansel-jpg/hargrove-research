<!-- Hero canvas: WebGL-style particle network with glow effects -->
<script>
(function() {
  var canvas = document.getElementById('hero-canvas');
  if (!canvas) return;
  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduced) return;

  var ctx = canvas.getContext('2d');
  var dpr = Math.min(window.devicePixelRatio || 1, 2);
  var w = 0, h = 0;
  var nodes = [];
  var NODE_COUNT = 80;
  var LINK_DIST = 160;
  var mouse = { x: -9999, y: -9999 };
  var hueShift = 0;

  function resize() {
    var rect = canvas.parentElement.getBoundingClientRect();
    w = rect.width;
    h = rect.height;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    canvas.style.width = w + 'px';
    canvas.style.height = h + 'px';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function initNodes() {
    nodes = [];
    for (var i = 0; i < NODE_COUNT; i++) {
      nodes.push({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.6,
        vy: (Math.random() - 0.5) * 0.6,
        r: 1.5 + Math.random() * 2.5,
        c: Math.random() > 0.7 ? 'copper' : (Math.random() > 0.5 ? 'signal' : 'ink'),
        pulse: Math.random() * Math.PI * 2
      });
    }
  }

  function step() {
    ctx.clearRect(0, 0, w, h);
    hueShift += 0.2;

    // Update + draw nodes with pulsing effect
    for (var i = 0; i < nodes.length; i++) {
      var a = nodes[i];
      a.x += a.vx; a.y += a.vy;
      a.pulse += 0.03;
      
      if (a.x < 0 || a.x > w) a.vx *= -1;
      if (a.y < 0 || a.y > h) a.vy *= -1;

      // Mouse interaction with attraction
      var dx = a.x - mouse.x, dy = a.y - mouse.y;
      var d2 = dx*dx + dy*dy;
      if (d2 < 200*200 && d2 > 0.01) {
        var d = Math.sqrt(d2);
        var f = (200 - d) / 200 * 0.4;
        a.vx += (dx/d) * f;
        a.vy += (dy/d) * f;
      }

      // Damping
      a.vx *= 0.99; a.vy *= 0.99;
      if (Math.abs(a.vx) < 0.03) a.vx += (Math.random() - 0.5) * 0.03;
      if (Math.abs(a.vy) < 0.03) a.vy += (Math.random() - 0.5) * 0.03;
    }

    // Glow effect before drawing
    ctx.globalCompositeOperation = 'lighter';
    
    // Links with gradient opacity
    for (var i = 0; i < nodes.length; i++) {
      for (var j = i + 1; j < nodes.length; j++) {
        var a = nodes[i], b = nodes[j];
        var dx = a.x - b.x, dy = a.y - b.y;
        var d = Math.sqrt(dx*dx + dy*dy);
        if (d < LINK_DIST) {
          var alpha = (1 - d / LINK_DIST) * 0.35;
          var hue = (hueShift + i * 5) % 360;
          ctx.strokeStyle = `hsla(${hue}, 70%, 70%, ${alpha})`;
          ctx.lineWidth = 0.8;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.stroke();
        }
      }
    }
    
    ctx.globalCompositeOperation = 'source-over';

    // Nodes with glow
    for (var i = 0; i < nodes.length; i++) {
      var n = nodes[i];
      var pulseScale = 1 + Math.sin(n.pulse) * 0.15;
      var radius = n.r * pulseScale;
      
      // Glow shadow
      var glowColor = n.c === 'copper' ? '224, 149, 67' : 
                     n.c === 'signal' ? '109, 93, 246' : '199, 208, 232';
      
      ctx.shadowBlur = 15;
      ctx.shadowColor = `rgba(${glowColor}, 0.6)`;
      
      if (n.c === 'copper') {
        ctx.fillStyle = `rgba(224, 149, 67, ${0.7 + Math.sin(n.pulse) * 0.2})`;
      } else if (n.c === 'signal') {
        ctx.fillStyle = `rgba(109, 93, 246, ${0.7 + Math.sin(n.pulse) * 0.2})`;
      } else {
        ctx.fillStyle = `rgba(199, 208, 232, ${0.6 + Math.sin(n.pulse) * 0.15})`;
      }
      
      ctx.beginPath();
      ctx.arc(n.x, n.y, radius, 0, Math.PI * 2);
      ctx.fill();
      
      // Inner highlight
      ctx.shadowBlur = 0;
      ctx.fillStyle = 'rgba(255,255,255,0.4)';
      ctx.beginPath();
      ctx.arc(n.x - radius*0.3, n.y - radius*0.3, radius*0.4, 0, Math.PI * 2);
      ctx.fill();
    }

    requestAnimationFrame(step);
  }

  function onMouse(e) {
    var rect = canvas.getBoundingClientRect();
    mouse.x = e.clientX - rect.left;
    mouse.y = e.clientY - rect.top;
  }
  function onLeave() { mouse.x = -9999; mouse.y = -9999; }

  resize();
  initNodes();
  step();

  window.addEventListener('resize', function() { resize(); initNodes(); }, { passive: true });
  canvas.parentElement.addEventListener('mousemove', onMouse, { passive: true });
  canvas.parentElement.addEventListener('mouseleave', onLeave, { passive: true });

  // Timestamp ticker
  var ts = document.getElementById('hero-timestamp');
  if (ts) {
    function updateTs() {
      var d = new Date();
      var pad = function(n) { return String(n).padStart(2, '0'); };
      ts.textContent = pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds()) + ' UTC' + (d.getTimezoneOffset() <= 0 ? '+' : '-') + Math.abs(d.getTimezoneOffset()/60);
    }
    updateTs();
    setInterval(updateTs, 1000);
  }
})();
</script>
